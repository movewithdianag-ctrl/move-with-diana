# Netlify response headers.
# /v2 is an unlisted test page. Keep it out of search results even for
# crawlers that do not run JavaScript.
/v2
  X-Robots-Tag: noindex, nofollow

# /book/* are the standalone booking pages, sent to clients as a direct link.
# Keep them out of search results too.
/book/*
  X-Robots-Tag: noindex, nofollow
