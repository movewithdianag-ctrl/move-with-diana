# Web3Forms access key: create a free key at https://web3forms.com using
# movewithdianag@gmail.com. Every contact-form and newsletter submission is
# emailed to that inbox. Without this key the site still works: forms validate,
# log their payload to the console, and show the success state (preview mode).
VITE_WEB3FORMS_KEY=

# 8-Week Pilates Program intake form endpoint: the Google Apps Script web app URL
# (it ends in /exec) that saves each application to the Google Sheet and sends
# the lead alerts. Setup steps are in integrations/google-sheet/SETUP.md (the
# optional text and push alerts on top are in docs/LEAD-ALERTS-SETUP.md). Leave empty
# until the sheet is connected: applications are then emailed through
# Web3Forms instead. With that key empty too, a built site shows
# "could not send".
VITE_INTAKE_ENDPOINT=

# Dev server only: `npm run dev` never sends an application, a contact form or
# a newsletter signup (it logs a preview to the browser console instead).
# Uncomment and set to 1 to send for real.
# VITE_INTAKE_SEND_IN_DEV=
